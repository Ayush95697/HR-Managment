  {
    "Logging": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Serilog": {
      "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
      "MinimumLevel": {
        "Default": "Information",
        "Override": {
          "Microsoft": "Warning",
          "System": "Warning"
        }
      },
      "WriteTo": [
        { "Name": "Console" },
        {
          "Name": "File",
          "Args": {
            "path": "logs/log.json",
            "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
            "rollingInterval": "Day",
            "retainedFileCountLimit": 7,
            "fileSizeLimitBytes": 10485760,
            "rollOnFileSizeLimit": true
          }
        }
      ],
      "Enrich": [ "FromLogContext" ]
    },
    "AllowedHosts": "*",
    "AllowedOrigins": [],
    "ConnectionStrings": {
      "//DefaultConnection": "Local secrets are stored in appsettings.Development.json",
      "DefaultConnection": ""
    },
    "JwtSettings": {
      "//Secret": "Local secrets are stored in appsettings.Development.json",
      "Secret": "",
      "Issuer": "HrSystemApi",
      "Audience": "HrSystemApp",
      "AccessTokenExpirationMinutes": 15,
      "RefreshTokenExpirationDays": 7
    },
    "Email": {
      "FromAddress": "",
      "GmailPassword": ""
    },
    "AzureStorage": {
      "ConnectionString": "",
      "AvatarContainerName": "avatars"
    },
    "Assistant": {
      "Provider": "Nvidia",
      "Model": "meta/llama-3.1-70b-instruct",
      "Endpoint": "https://integrate.api.nvidia.com/v1/chat/completions",
      "Temperature": 0.3,
      "MaxTokens": 2048
    }
  }